# Ratchet needs no configuration to run: the default provider is an offline echo
# and the database is a local file. Copy this to `.env` only if you want to point
# it at a real model.
#
# Never commit a filled-in `.env`. It is already in .gitignore.

# Any OpenAI-compatible endpoint.
OPENAI_API_KEY=sk-...

# Optional overrides; the CLI flags take precedence over these.
# RATCHET_DB=ratchet.db
# RATCHET_BASE_URL=https://api.openai.com/v1
# RATCHET_MODEL=gpt-4o-mini

# Local runtimes (Ollama, LM Studio, vLLM) usually need no key.
# RATCHET_BASE_URL=http://localhost:11434/v1
# RATCHET_MODEL=qwen2.5
