# Store text as LF in the repository; Windows checkouts may convert locally.
* text=auto eol=lf

*.py   text eol=lf diff=python
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf

*.db     binary
*.sqlite binary
*.zip    binary
*.png    binary
*.jpg    binary
